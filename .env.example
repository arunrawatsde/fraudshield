# --- required for the agent ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536

# --- optional: Pinecone knowledge base (falls back to local TF-IDF search if empty) ---
PINECONE_API_KEY=
PINECONE_INDEX=fraudshield-playbook
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- optional: Langfuse tracing (skipped if empty) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- tuning ---
FLAG_THRESHOLD=0.2
MAX_TOOL_ROUNDS=6
